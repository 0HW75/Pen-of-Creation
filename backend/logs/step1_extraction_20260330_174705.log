  "historical_events": [
    {
      "id": "event_001",
      "name": "陈启上报穿越能力事件",
      "type": "发现/上报事件",
      "brief": "故事的核心起始事件。普通大学毕业生陈启在确认自身拥有打开异世界之“门”的能力后，经过思想斗争，选择通过特殊网络渠道匿名向中央联邦安全部发送加密报告。这一行为将个体的超自然秘密转变为国家最高机密，直接触发了后续一系列连锁反应，包括秘密调查、询问测试、以及最终【零号工程】的批准与启动。该事件是连接平凡世界与非凡未来的关键节点。",
      "importance_level": 9
    },
    {
      "id": "event_002",
      "name": "零号工程启动",
      "type": "国家计划启动事件",
      "brief": "在陈启的能力被多领域专家初步证实后，由禹州中央联邦政府在“最高层面”批准启动的绝密计划。该事件的决策层级极高，保密等级为“最高绝密”。它标志着国家力量正式、系统性地介入对异世界穿越能力及相关现象的研究与开发。伴随该事件的是代号“昆仑”的绝密基地紧急开建，以及陈启被授予“最高权限顾问”身份。这是国家战略方向的一次重大调整。",
      "importance_level": 9
    }
  ],
