  "civilizations": [
    {
      "id": "civ_001",
      "name": "禹州文明（主角所在世界）",
      "type": "现代/近未来国家文明",
      "brief": "陈启和李卫国所属的文明。从文本中出现的“中央联邦安全部”、“军用机场”、“绝密计划”、“多领域专家”等元素推断，这是一个发展到与现代地球文明相似或略高的科技与社会组织水平的国家文明。它拥有成熟的国家安全体系、科研能力、军事力量和高效的行政执行力。在面对“异世界穿越”这种超自然现象时，其反应迅速、系统且高度保密，展现出一种理性、务实且注重控制的国家行为模式。该文明目前处于一个因个体超能力发现而可能面临剧变的门槛上。",
      "importance_level": 8
    }
  ],
